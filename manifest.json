{
  "manifest_version": 3,
  "name": "TS Reporter",
  "version": "2.0.0",
  "description": "Incognito-only reporting helper with fingerprint anti-detect.",
  "incognito": "split",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "notifications",
    "declarativeNetRequest",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": ["https://www.twitch.tv/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["content/isolated.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["content/injected.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN",
      "match_about_blank": true
    },
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": { "default_title": "TS Reporter (incognito only)" }
}